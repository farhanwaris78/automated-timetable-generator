# ---------------------------------------------------------------------------
# Optional configuration. Copy to ".env" next to the executable and edit.
# The application works perfectly with NO .env file at all (embedded SQLite).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# TTG_HOST=127.0.0.1
# TTG_PORT=5000            # 0 or unset = pick the first free port
# TTG_OPEN_BROWSER=1       # 0 = server only (do not launch the browser/window)
# TTG_WINDOW_NATIVE=1      # 1 = own desktop window (default), 0 = browser
# TTG_DEBUG=0

# --- Storage ----------------------------------------------------------------
# TTG_DATA_DIR=C:\TimetableData     # where the DB + logs live
# TTG_SEED_DEMO_DATA=1              # 0 = start with an empty database

# --- Database (pick ONE style; leave everything blank for local SQLite) ------
# 1) Any SQLAlchemy URL
# TTG_DATABASE_URL=sqlite:///C:/TimetableData/timetable.db
# TTG_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/timetable
# TTG_DATABASE_URL=mysql+pymysql://user:pass@host:3306/timetable

# 2) Microsoft SQL Server, part by part (requires: pip install pyodbc)
# DB_SERVER=DESKTOP-99MP30B
# DB_PORT=1433
# DB_NAME=timetable
# DB_USER=sa
# DB_PASSWORD=your_password
# DB_DRIVER=ODBC Driver 17 for SQL Server
#   (omit DB_USER/DB_PASSWORD to use Windows Trusted Connection)

# 3) A raw ODBC connection string
# DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.;DATABASE=timetable;Trusted_Connection=yes;
